{
  "name": "study-tracker",
  "version": "1.0.0",
  "description": "Desktop app to track study hours, manage courses and visualize progress. Built with Electron, React 19, TypeScript, Prisma and SQLite.",
  "main": "dist-electron/main/index.js",
  "author": "Luis Eduardo",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/merino626/study-tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/merino626/study-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/merino626/study-tracker/issues"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "prisma",
    "sqlite",
    "desktop-app",
    "study-tracker",
    "pomodoro",
    "productivity"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "prisma generate && vite build && electron-builder",
    "build:win": "prisma generate && vite build && electron-builder --win",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.7",
    "adm-zip": "^0.5.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.525.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.67",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.0.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "prisma": "^6.9.0",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
